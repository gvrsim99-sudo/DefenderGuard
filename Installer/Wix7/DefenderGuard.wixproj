<Project Sdk="WixToolset.Sdk/7.0.0">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>
    <AcceptEula>wix7</AcceptEula>
    <Version>1.0.2</Version>
    <OutputPath>..\..\..\..\DefenderGuard-installer-wix\</OutputPath>
    <DefineConstants>PublishDir=..\..\..\..\DefenderGuard-release-$(Version);MsiVersion=$(Version).0</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="DefenderGuardBundle.wxs" />
    <PackageReference Include="WixToolset.UI.wixext" Version="7.0.0" />
    <PackageReference Include="WixToolset.Util.wixext" Version="7.0.0" />
  </ItemGroup>
</Project>